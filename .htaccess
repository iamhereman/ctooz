# Prevent Search Engine Indexing (Google, Bing, Crawlers)
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# Enable URL Rewriting
RewriteEngine On
RewriteBase /

# Block sensitive files
<FilesMatch "\.(db|sql|json|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 1. Route /api/* requests to api.php
RewriteRule ^api/create-invoice$ api.php?action=create-invoice [QSA,L]
RewriteRule ^api/simulate-payment$ api.php?action=simulate-payment [QSA,L]
RewriteRule ^api/invoice-status$ api.php?action=invoice-status [QSA,L]
RewriteRule ^api/send-confirmation-email$ api.php?action=send-confirmation-email [QSA,L]
RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

# 2. Redirect /index or /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(?:\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 3. Redirect any request ending in .html to clean URL (e.g. /about.html -> /about)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 4. Internally rewrite extensionless URL to corresponding .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
